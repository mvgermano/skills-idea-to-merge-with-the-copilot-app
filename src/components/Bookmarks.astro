---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>
<p id="status" role="status" aria-live="polite" hidden></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('status');
  const clearAll = document.getElementById('clear-all');

  if (
    form instanceof HTMLFormElement &&
    urlInput instanceof HTMLInputElement &&
    list instanceof HTMLUListElement &&
    emptyState instanceof HTMLElement &&
    listHeader instanceof HTMLElement &&
    status instanceof HTMLElement &&
    clearAll instanceof HTMLButtonElement
  ) {
    let bookmarks = loadBookmarks();

    function showStatus(message) {
      status.textContent = message;
      status.hidden = message.length === 0;
    }

    function isHttpUrl(value) {
      try {
        const parsed = new URL(value);
        return (parsed.protocol === 'http:' || parsed.protocol === 'https:') && parsed.hostname.length > 0;
      } catch {
        return false;
      }
    }

    function loadBookmarks() {
      let saved;
      try {
        saved = localStorage.getItem(storageKey);
      } catch {
        showStatus('Bookmarks could not be read from this browser.');
        return [];
      }

      if (saved === null) return [];

      let parsed;
      try {
        parsed = JSON.parse(saved);
      } catch {
        showStatus('Saved bookmarks are invalid and could not be loaded.');
        return [];
      }

      if (
        !Array.isArray(parsed) ||
        !parsed.every((item) =>
          item &&
          typeof item.url === 'string' &&
          isHttpUrl(item.url) &&
          typeof item.slug === 'string' &&
          /^mona-[a-f0-9]{8}$/.test(item.slug)
        )
      ) {
        showStatus('Saved bookmarks are invalid and could not be loaded.');
        return [];
      }

      return parsed;
    }

    function render() {
      list.replaceChildren();
      for (const bookmark of bookmarks) {
        const row = document.createElement('li');
        row.className = 'bookmark';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.className = 'copy';
        copy.type = 'button';
        copy.textContent = 'Copy';
        copy.addEventListener('click', async () => {
          if (!navigator.clipboard) {
            showStatus('Clipboard access is unavailable in this browser.');
            return;
          }

          try {
            await navigator.clipboard.writeText(bookmark.slug);
            showStatus(`Copied ${bookmark.slug}.`);
          } catch {
            showStatus('Could not copy the slug. Check clipboard permissions and try again.');
          }
        });

        row.append(link, slug, copy);
        list.append(row);
      }

      const hasBookmarks = bookmarks.length > 0;
      emptyState.hidden = hasBookmarks;
      listHeader.hidden = !hasBookmarks;
    }

    function makeSlug() {
      let slug;
      do {
        const bytes = new Uint8Array(4);
        window.crypto.getRandomValues(bytes);
        const suffix = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
        slug = `mona-${suffix}`;
      } while (bookmarks.some((bookmark) => bookmark.slug === slug));
      return slug;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const url = urlInput.value.trim();

      if (!isHttpUrl(url)) {
        showStatus('Enter a valid http:// or https:// URL.');
        urlInput.focus();
        return;
      }

      if (!window.crypto?.getRandomValues) {
        showStatus('This browser cannot generate a bookmark slug.');
        return;
      }

      const next = [...bookmarks, { url, slug: makeSlug() }];
      try {
        localStorage.setItem(storageKey, JSON.stringify(next));
      } catch {
        showStatus('Bookmark could not be saved to this browser.');
        return;
      }

      bookmarks = next;
      render();
      form.reset();
      urlInput.focus();
      showStatus('Bookmark saved.');
    });

    clearAll.addEventListener('click', () => {
      if (!window.confirm('Clear all saved bookmarks?')) return;

      try {
        localStorage.removeItem(storageKey);
      } catch {
        showStatus('Bookmarks could not be cleared from this browser.');
        return;
      }

      bookmarks = [];
      render();
      showStatus('All bookmarks cleared.');
    });

    render();
  }
</script>
